# Hedgeclip-eigenes Deployment-Artefakt (Auflage 1/2/4, Entwurf HED-36 Abschnitt 3;
# CRO-Nachforderung HED-42, Punkt 3).
#
# Diese Plattform hat auch Deployments ohne jeden Bezug zu Hedgeclip (siehe
# deploy/paper-trading.env.example, docs/hostinger.md, docs/proxmox.md), die
# BETRIEBSART/ARTEFAKT_ART nie gesetzt haben und bei ENFORCE_STARTGATTER=true nicht
# mehr starten würden -- deshalb bleibt der Anwendungs-Default in app/config.py aus.
#
# Jede Hedgeclip-Installation (Papier UND Live) installiert deshalb NICHT mit dem
# generischen Befehl aus docs/deployment.md, sondern mit:
#
#   sudo deploy/install.sh --env-template deploy/hedgeclip.env.example
#
# "--env-template" kopiert diese Datei als vollständige /etc/paper-trading/paper-
# trading.env -- nicht nur als Überlagerung. Deshalb steht hier jedes Feld aus
# deploy/paper-trading.env.example noch einmal drin, nicht nur die Hedgeclip-eigenen
# Zeilen. deploy/install.sh bricht ab, wenn der übergebene Pfad im ausgecheckten Repo
# nicht existiert. Fehlt BETRIEBSART oder ARTEFAKT_ART trotzdem, verweigert der Prozess
# den Start (Startgatter, Sofort-Stopp-Fall) -- kein eingeschränkter Modus.
#
# Format wie deploy/paper-trading.env.example: NAME=value, keine Anführungszeichen.
# --env-template wirkt nur bei der Ersteinrichtung; ein bestehendes ENV_FILE bleibt bei
# einem Upgrade unverändert ("Keeping the existing ...").

# Adresse/Port setzt der Installer über --host/--port; diese Zeilen sind trotzdem Teil
# der Datei, weil --env-template die komplette Datei liefert, nicht nur einen Zusatz.
APP_HOST=0.0.0.0
APP_PORT=8000

# Je eigene Installation (Papier UND Live) MIT EIGENER Datenbank -- nie derselbe Pfad,
# nie derselbe Prozess (Auflage 1, Brett-Entscheidung 05.10.2026). Auf jedem Host
# unverändert lassen, nicht zwischen Installationen kopieren.
DATABASE_URL=sqlite+aiosqlite:////var/lib/paper-trading/app.db
LOCK_FILE=/var/lib/paper-trading/backend.lock

COOKIE_SECURE=false

# Nicht optional für Hedgeclip-Installationen. Siehe app/config.py Settings.enforce_startgatter.
ENFORCE_STARTGATTER=true

# "papier" oder "live" -- einmal beim Prozessstart gelesen, danach unveränderlich
# (Auflage 1). Jede Installation setzt genau einen Wert, nie beide.
BETRIEBSART=papier

# "papier_artefakt" oder "live_artefakt" -- muss zum ARTEFAKT_ART passen, mit dem das
# Image gebaut wurde (Dockerfile ARG ARTEFAKT_ART), sonst verweigert der Startgatter
# den Start (Auflage 4).
ARTEFAKT_ART=papier_artefakt

# Gegenstellen-Schlüssel folgen der Namenskonvention {BOERSE}_{DEMO|LIVE}_API_KEY usw.
# (app/schluessel.py). Auf einer Papier-Installation darf hier ausschließlich der
# *_DEMO_*-Schlüssel stehen -- ein hier lesbarer *_LIVE_*-Schlüssel ist das benannte
# Hauptrisiko und wird vom Startgatter mit Sofort-Stopp quittiert, nicht nur protokolliert.
#OKX_DEMO_API_KEY=
#OKX_DEMO_API_SECRET=
#OKX_DEMO_PASSPHRASE=
