# Settings for the paper trading platform service.
#
# The installer copies this file to /etc/paper-trading/paper-trading.env once and
# never overwrites it. Apply a change with:
#
#   sudo systemctl restart paper-trading
#
# Format: NAME=value, one per line, no quotes and no spaces around "=".

# Address and port the platform listens on.
# Use 127.0.0.1 when a reverse proxy on this machine sits in front of it.
APP_HOST=0.0.0.0
APP_PORT=8000

# Where the data lives. The four slashes make the path absolute.
DATABASE_URL=sqlite+aiosqlite:////var/lib/paper-trading/app.db
LOCK_FILE=/var/lib/paper-trading/backend.lock

# Set to true when the platform is served over HTTPS.
COOKIE_SECURE=false

# Price sources per asset class, tried in order. Any ccxt exchange id works.
#CHAIN_CRYPTO=okx,kraken,coinbase,yahoo
#CHAIN_STOCKS=yahoo
#CHAIN_ETFS=yahoo
#CHAIN_COMMODITIES=yahoo
#CHAIN_FOREX=yahoo

# Apply database migrations at startup.
#AUTO_MIGRATE=true

# Evaluate open orders and write daily value points in the background.
#RUN_MATCHER=true

# Check at startup, and daily, which source prices each asset.
#CHECK_ASSETS_ON_STARTUP=true
