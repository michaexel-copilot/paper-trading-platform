# Copy to .env next to docker-compose.yml. Adjust to your Traefik setup.
TRADING_DOMAIN=trading.michaexel.de
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Hedgeclip deployments only (Auflage 1/2, HED-36 Abschnitt 3): uncomment both, and set
# BETRIEBSART to exactly the betriebsart this image was built for. Leave both commented
# out for any deployment of this compose file that is not a Hedgeclip installation --
# see deploy/hedgeclip.env.example for the systemd/install.sh equivalent of this gate.
#ENFORCE_STARTGATTER=true
#BETRIEBSART=papier
